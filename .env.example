# Copy using: python scripts/manage.py init
# Keep real .env files private. VITE_* values are public browser configuration.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Enable deliberately after adding a backend key; all paid calls honor this switch.
PAID_AI_ENABLED=false
CHAT_MAX_OUTPUT_TOKENS=1536
CHAT_HISTORY_MESSAGES=8
EMBEDDINGS_MODEL=text-embedding-3-small
INDEX_DIR=data/index

# Owner data: defaults to .local files when present, otherwise fictional examples.
# PORTFOLIO_PROFILE=config/profile.local.json
# CONTENT_MANIFEST=config/content.local.json

# init generates independent local credentials in .env.local.
PRIVATE_CV_ENABLED=true
CV_PUBLIC_ORIGIN=http://127.0.0.1:3000
CV_API_ORIGIN=http://127.0.0.1:8000
CV_ACCESS_PASSWORD_HASH=
CV_API_PROXY_SECRET=

# Production platforms inject variables; do not load a bundled dotenv there.
LOAD_DOTENV=true
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional bounded session persistence. No archive/export API is included.
POSTGRES_ENABLED=false
PERSISTENT_CHAT_HISTORY_ENABLED=false
DATABASE_URL=
POSTGRES_PASSWORD=
CHAT_SESSION_TTL_SECONDS=86400

# Optional graph retrieval. snapshot runs locally without a database.
# neo4j requires explicit ingestion: python scripts/showcase.py graph --neo4j
KNOWLEDGE_GRAPH_ENABLED=false
GRAPH_RETRIEVAL_ENABLED=false
GRAPH_BACKEND=snapshot
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Offline-trained GraphSAGE. Shadow preserves the hybrid answer order.
# Active reranking additionally requires a matching passed evaluation gate.
GNN_SHADOW_ENABLED=false
GNN_RERANKING_ENABLED=false
GNN_CANARY_PERCENT=0
GNN_ARTIFACT_DIR=models/gnn/artifacts/current
GNN_ACTIVATION_GATE=models/gnn/evaluation/gate.json
